{
  "expo": {
    "name": "ZocaloTrade",
    "slug": "zocalotrade",
    "scheme": "zocalotrade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.zocalotrade.app",
      "versionCode": 1
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zocalotrade.app",
      "buildNumber": "1"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite que ZocaloTrade use tu ubicación para encontrar comerciantes cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que ZocaloTrade acceda a tus fotos para subir imágenes de productos.",
          "cameraPermission": "Permite que ZocaloTrade use tu cámara para tomar fotos de productos."
        }
      ],
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "o4511107888119808",
          "project": "zocalotrade-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
